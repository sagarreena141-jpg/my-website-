WhvcPuZy7gAQ38" aria-pressed="false" role="button" tabindex="0" jsaction="h5M12e;rcuQ6b:npT2md"><div class="byBZxc lVjPIb hhqdmd" data-ved="2ahUKEwjZ6Y6osMKWAxVvi-EIHTnODkAQvP0IegQINhAD"><span class="kXq04d hhqdmd z1asCe JKu1je"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"></path></svg></span></div><div class="mt7SKb jTjPhe hhqdmd" style="display:none" data-ved="2ahUKEwjZ6Y6osMKWAxVvi-EIHTnODkAQu_0IegQINhAE"><span class="kXq04d hhqdmd z1asCe E9ShGc" lang="en"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"></path></svg></span></div></div></div><div><h3 class="bNg8Rb">Description</h3><span><span>Michael, an aggressive young man, gives up his dream of becoming a footballer after his father's murder. However, a friend convinces him to coach a women's football team and turn his life around.</span></span></div></div></div></div></div><div jscontroller="GCSbhd" lang="hi" jsaction="SKAaMe:c0XUbe;rcuQ6b:npT2md" data-hveid="CDYQBQ" data-ved="2ahUKEwjZ6Y6osMKWAxVvi-EIHTnODkAQne4IegQINhAF"><div jscontroller="QhoyLd" jsaction="rcuQ6b:npT2md"><div jsname="g7W7Ed" jscontroller="tIhjPc" class="kno-rdesc" jsaction="seM7Qe:c0XUbe;Iigoee:h06R8;rcuQ6b:npT2md"><div class="xf67ce"><div class="fyKPC"><div jscontroller="ZB7Jmb" style="width:max-content" data-disablecolor="#dadce0" lang="hi" jsmodel="GNvs9d" aria-label="इसे सुनें" jsdata="XDxzyc;_;6_-QapnIEO-WhvcPuZy7gAQ39" aria-pressed="false" role="button" tabindex="0" jsaction="h5M12e;rcuQ6b:npT2md"><div class="byBZxc lVjPIb hhqdmd" data-ved="2ahUKEwjZ6Y6osMKWAxVvi-EIHTnODkAQvv0IegQINhAG"><span class="kXq04d hhqdmd z1asCe JKu1je"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"></path></svg></span></div><div class="mt7SKb jTjPhe hhqdmd" style="display:none" data-ved="2ahUKEwjZ6Y6osMKWAxVvi-EIHTnODkAQvf0IegQINhAH"><span class="kXq04d hhqdmd z1asCe E9ShGc" lang="hi"><svg focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"></path></svg></span></div></div></div><div><h3 class="bNg8Rb">जानकारी</h3><span><span>अपने पिता की हत्या के बाद माइकल अपना फुटबॉलर बनने का अपना सपना छोड़ देता है। हालांकि, एक दोस्त उसे एक महिला फुटबॉल टीम का कोच बनाने के लिए मनाता है और यह फैसला उसका जीवन बदल देता है।</span></span></div></div></div></div></div><div><a class="gSvQjc DH0JFd BvvxHb" href="https://www.google.com/search?sca_esv=9cb5d0058d5e6f03&amp;rlz=1C1CHBD_enIN1117IN1117&amp;biw=681&amp;bih=632&amp;sxsrf=APpeQnvJ-KBm1E7G9fABjtBznEuz_SGxGQ:1787887595278&amp;q=%E0%A4%AC%E0%A4%BF%E0%A4%97%E0%A4%BF%E0%A4%B2&amp;hl=hi&amp;sa=X&amp;ved=2ahUKEwjZ6Y6osMKWAxVvi-EIHTnODkAQnu4IKAB6BAg2EAg" role="button" tabindex="0"><span lang="hi">हिन्दी में खोजें</span><span> :&nbsp;</span><span class="XJCgvb">बिगिल</span></a></div></div></div></div><div><div class="kD0Vhf"><div class="b3puKe"><div role="presentation" class="wDYxhc" data-attrid="kc:/film/film:theatrical region aware release date" data-md="1001" style="clear:none" data-hveid="CE8QAA" data-ved="2ahUKEwjZ6Y6osMKWAxVvi-EIHTnODkAQkCl6BAhPEAA"><div class="Z1hOCe"><div class="zloOqf PZPZlf"><div class="zh0Yff rVusze"><span class="w8qArf FoJoyf">Release date<span>:</span> </span><span><span class="LrzXr kno-fv wHYlTd z8gr9e">25 October 2019 (<a class="fl" href="https://www.google.com/search?sca_esv=9c